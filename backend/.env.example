# AICoach 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ===== LLM 配置（必填） =====
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
APP_LLM_API_KEY=sk-your-deepseek-api-key-here

# ===== LLM 配置（可选，有默认值） =====
# LLM 服务地址（如使用其他兼容 OpenAI 的服务，修改此项）
# APP_LLM_BASE_URL=https://api.deepseek.com
# APP_LLM_MODEL=deepseek-chat
# APP_LLM_TEMPERATURE=0.3

# ===== 应用配置（可选） =====
# APP_DEBUG=true
# APP_DATABASE_URL=sqlite+aiosqlite:///./aicoach.db

# ===== JWT 认证配置（可选，有默认值） =====
# JWT 签名密钥（生产环境务必修改！）
# APP_SECRET_KEY=your-super-secret-key-change-in-production
# JWT 算法（默认 HS256）
# APP_ALGORITHM=HS256
# Token 有效期（分钟，默认 7 天）
# APP_ACCESS_TOKEN_EXPIRE_MINUTES=10080
